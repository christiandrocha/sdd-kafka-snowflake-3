# .env.example — copy to `.env` and fill in. `.env` is gitignored and must
# never be committed; the CI workflow has a step that fails if it ever is.
#
# The private key itself does NOT belong here. It lives as a .p8 file under
# `keys/` (also gitignored) and is referenced by path below.

# ── Source PostgreSQL (the CDC source Debezium reads from) ──────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Used by tests/load_to_postgres.py, e.g. postgresql://user:pass@localhost:5432/db
DATABASE_URL=

# ── Snowflake (RSA key-pair authentication) ─────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Path INSIDE the containers — ./keys is bind-mounted at /secrets:ro, and dbt
# and Dagster are what consume it. register_connectors.sh runs on the host,
# where /secrets does not exist, so it tries this path first and falls back to
# the same filename under keys/.
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/rsa_key.p8
SNOWFLAKE_DATABASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_URL=

# NOTE: SNOWFLAKE_PRIVATE_KEY (the whole PKCS8 body as a string) is deliberately
# absent. Until 2026-08-11 the key lived here a second time, because the Kafka
# connector and scripts/sync_metadata.py need it as a string. The duplication
# cost a leaked key and turned rotation into a five-location procedure. Both
# consumers now derive the string from the .p8 file. Setting it still works, for
# environments that have not migrated.

# ── Kafka ───────────────────────────────────────────────────────────────────
SCHEMA_REGISTRY_URL=http://schema-registry:8081

# ── dbt ─────────────────────────────────────────────────────────────────────
DBT_TARGET=dev

# ── Dagster storage (the dedicated Postgres of ADR-0018, not the CDC source) ─
DAGSTER_PG_DB=
DAGSTER_PG_USER=
DAGSTER_PG_PASSWORD=

# ── Measurement (COST_GOVERNANCE; docs/measurement/PROTOCOL.md) ─────────────
# Sensor batching window in minutes (dagster/pipeline/sensors.py). It switches
# TOGETHER with cost_profile in terraform/env/dev.tfvars (DESIGN Decision 2):
#   0  = profile A (baseline, window A — v2 hot cycles)
#   10 = profile B (optimized, window B and idle)
# Keep it equal to what dev.tfvars on main says. Change it only with
# `make batch-window N=<0|10> SWITCH=<Sn>`, which also recreates both Dagster
# containers (env_file is read at creation) and logs the step in switch.log.
BATCH_WINDOW_MINUTES=10

# Load generator (tests/load/generate_load.py), run ON THE HOST by `make load`.
# Postgres as the generator sees it: the port the stack publishes. On a separate
# VM, point these at the stack host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Task-state check (DESIGN Decision 5): a CDC_ROLE_RO key-pair user, no warehouse.
# HOST path to that user's .p8 (e.g. under keys/), not the /secrets container path.
LOAD_SNOWFLAKE_USER=CURSOR_MCP_USER
LOAD_SNOWFLAKE_PRIVATE_KEY_PATH=
# LOAD_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Fixed by PROTOCOL §3 and identical in A and B. Leave them commented out (the
# generator's defaults apply) unless the dry run recalibrates them — and then
# record the change in PROTOCOL §9 before window A.
# LOAD_SEED=42
# LOAD_CLUSTER_MINUTES=120
# LOAD_BURST_OFFSETS=0,2,4,10,12
# LOAD_ROWS_PER_BURST=200
